# PocketBase the worker reads subscriptions and preferences from.
# In docker-compose this is the internal service URL.
PB_URL=http://127.0.0.1:8090

# A PocketBase superuser (create with: pocketbase superuser create <email> <pass>).
PB_ADMIN_EMAIL=admin@example.com
PB_ADMIN_PASSWORD=change-me-please

# VAPID keys — generate once with `npm run generate-vapid`.
# VAPID_PUBLIC_KEY must ALSO be set on the PocketBase process (the hook serves it).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com

# How often (ms) to evaluate reminders.
POLL_INTERVAL_MS=60000
